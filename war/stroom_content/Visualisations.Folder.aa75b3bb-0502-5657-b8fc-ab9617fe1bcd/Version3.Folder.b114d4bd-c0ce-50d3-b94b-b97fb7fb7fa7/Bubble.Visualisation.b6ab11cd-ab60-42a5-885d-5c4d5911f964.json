{
    "inputs": [
        {
            "id": "name",
            "label": "Name",
            "description": "What each bubble is",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "value",
            "label": "Value",
            "description": "How big each bubble is: its area; only values above zero have a bubble",
            "types": [
                "NUMBER"
            ],
            "required": true
        },
        {
            "id": "series",
            "label": "Series",
            "description": "Colours the bubbles by series, and unless flattened groups each series' bubbles in a bubble of its own",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "gridSeries",
            "label": "Grid series",
            "description": "Draws a separate chart for each value",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "name",
                    "type": "field",
                    "label": "Name"
                },
                {
                    "id": "value",
                    "type": "field",
                    "label": "Value"
                },
                {
                    "id": "series",
                    "type": "field",
                    "label": "Series"
                },
                {
                    "id": "gridSeries",
                    "type": "field",
                    "label": "Grid Series"
                }
            ]
        },
        {
            "name": "Bubble",
            "controls": [
                {
                    "id": "nameDateFormat",
                    "type": "text",
                    "label": "Name Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "500",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "flattenSeries",
                    "type": "selection",
                    "label": "Flatten",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "sortSeries",
                    "type": "selection",
                    "label": "Sort Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxSeries",
                    "type": "number",
                    "label": "Max Series",
                    "defaultValue": "100",
                    "min": "1",
                    "max": "10000"
                },
                {
                    "id": "seriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "sortGridSeries",
                    "type": "selection",
                    "label": "Sort Grid Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxGridSeries",
                    "type": "number",
                    "label": "Max Grid Series",
                    "defaultValue": "36",
                    "min": "1",
                    "max": "144"
                },
                {
                    "id": "gridSeriesDateFormat",
                    "type": "text",
                    "label": "Grid Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "showLabels",
                    "type": "selection",
                    "label": "Show Labels",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "False"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${gridSeries}",
                    "sort": {
                        "direction": "${sortGridSeries}",
                        "enabled": "true",
                        "priority": 0
                    }
                },
                "nest": {
                    "key": {
                        "id": "${series}",
                        "sort": {
                            "direction": "${sortSeries}",
                            "enabled": "true",
                            "priority": 1
                        }
                    },
                    "values": {
                        "fields": [
                            {
                                "id": "${name}",
                                "sort": {
                                    "direction": "Ascending",
                                    "enabled": "true",
                                    "priority": 2
                                }
                            },
                            {
                                "id": "${value}"
                            }
                        ],
                        "limit": {
                            "enabled": "true",
                            "size": "${maxValues}"
                        }
                    },
                    "limit": {
                        "enabled": "true",
                        "size": "${maxSeries}"
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "${maxGridSeries}"
                }
            }
        }
    }
}
