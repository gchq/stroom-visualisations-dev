{
    "inputs": [
        {
            "id": "days",
            "label": "Days",
            "description": "When each value was, its day the cell it is in (the values of a day are added together)",
            "types": [
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "values",
            "label": "Values",
            "description": "The value of each time, which the cell's colour shows",
            "types": [
                "NUMBER"
            ],
            "required": true
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "days",
                    "type": "field",
                    "label": "Days"
                },
                {
                    "id": "values",
                    "type": "field",
                    "label": "Values"
                }
            ]
        },
        {
            "name": "Heat Map",
            "controls": [
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "490",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "displayXAxis",
                    "type": "selection",
                    "label": "Display X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayYAxis",
                    "type": "selection",
                    "label": "Display Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "values": {
                "fields": [
                    {
                        "id": "${days}",
                        "sort": {
                            "enabled": "true",
                            "direction": "Ascending"
                        }
                    },
                    {
                        "id": "${values}"
                    }
                ],
                "limit": {
                    "enabled": "true",
                    "size": "${maxValues}"
                }
            }
        }
    }
}
