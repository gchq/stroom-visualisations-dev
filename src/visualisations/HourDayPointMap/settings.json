{
    "inputs": [
        {
            "id": "pointSeries",
            "label": "Point series",
            "description": "Puts each value's events in a lane and colour of its own",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "gridSeries",
            "label": "Grid series",
            "description": "Draws a separate map for each value",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "eventTime",
            "label": "Event time",
            "description": "When each event was: its day the row it is on, its time of day how far across",
            "types": [
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "value",
            "label": "Value",
            "description": "Shown in each event's tooltip",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "pointSeries",
                    "type": "field",
                    "label": "Point Series"
                },
                {
                    "id": "gridSeries",
                    "type": "field",
                    "label": "Grid Series"
                },
                {
                    "id": "eventTime",
                    "type": "field",
                    "label": "Event Time"
                },
                {
                    "id": "value",
                    "type": "field",
                    "label": "Value"
                }
            ]
        },
        {
            "name": "Points",
            "controls": [
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "5000",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "sortPointSeries",
                    "type": "selection",
                    "label": "Sort Point Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxPointSeries",
                    "type": "number",
                    "label": "Max Point Series",
                    "defaultValue": "100",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "seriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "sortGridSeries",
                    "type": "selection",
                    "label": "Sort Grid Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxGridSeries",
                    "type": "number",
                    "label": "Max Grid Series",
                    "defaultValue": "36",
                    "max": "144",
                    "min": "1"
                },
                {
                    "id": "gridSeriesDateFormat",
                    "type": "text",
                    "label": "Grid Series Date Format (optional)",
                    "defaultValue": ""
                },
                {
                    "id": "synchXAxis",
                    "type": "selection",
                    "label": "Synch Event Times",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayXAxis",
                    "type": "selection",
                    "label": "Display X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayYAxis",
                    "type": "selection",
                    "label": "Display Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${gridSeries}",
                    "sort": {
                        "direction": "${sortGridSeries}",
                        "enabled": "true",
                        "priority": 0
                    }
                },
                "nest": {
                    "key": {
                        "id": "${pointSeries}",
                        "sort": {
                            "direction": "${sortPointSeries}",
                            "enabled": "true",
                            "priority": 1
                        }
                    },
                    "limit": {
                        "enabled": "true",
                        "size": "${maxPointSeries}"
                    },
                    "values": {
                        "fields": [
                            {
                                "id": "${eventTime}",
                                "sort": {
                                    "direction": "Ascending",
                                    "enabled": "true",
                                    "priority": 2
                                }
                            },
                            {
                                "id": "${value}"
                            }
                        ],
                        "limit": {
                            "enabled": "true",
                            "size": "${maxValues}"
                        }
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "${maxGridSeries}"
                }
            }
        }
    }
}
