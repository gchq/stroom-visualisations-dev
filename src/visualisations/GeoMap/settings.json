{
    "inputs": [
        {
            "id": "name",
            "label": "Name",
            "description": "What each marker is, the title of its tooltip",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "lat",
            "label": "Latitude",
            "description": "Where each marker is north (up to 90) or south (down to -90)",
            "types": [
                "NUMBER",
                "TEXT"
            ],
            "required": true
        },
        {
            "id": "lon",
            "label": "Longitude",
            "description": "Where each marker is east (up to 180) or west (down to -180)",
            "types": [
                "NUMBER",
                "TEXT"
            ],
            "required": true
        },
        {
            "id": "eventTime",
            "label": "Event time",
            "description": "When each marker was there, which can colour it, from earliest to latest",
            "types": [
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "iconName",
            "label": "Icon name",
            "description": "Gives each marker an icon: person, people, desktop, laptop, server, phone, building, home, car, truck, plane, ship, flag, warning, lock, wifi, globe, camera, envelope, cloud, database, shield, bolt, fire, pin, key, clock or eye (or FontAwesome 4's name for one, e.g. male or ambulance); or a shape: circle, square, triangle, diamond, star, cross or wye; or for any other value, a shape of its own",
            "types": [
                "TEXT",
                "NUMBER"
            ],
            "required": false
        },
        {
            "id": "series",
            "label": "Series",
            "description": "Gives each value's markers its colour, and a legend to hide them",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "gridSeries",
            "label": "Grid series",
            "description": "Draws a separate map for each value",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "name",
                    "type": "field",
                    "label": "Name"
                },
                {
                    "id": "lat",
                    "type": "field",
                    "label": "Latitude"
                },
                {
                    "id": "lon",
                    "type": "field",
                    "label": "Longitude"
                },
                {
                    "id": "eventTime",
                    "type": "field",
                    "label": "Event Time (optional)"
                },
                {
                    "id": "iconName",
                    "type": "field",
                    "label": "Icon Name"
                },
                {
                    "id": "series",
                    "type": "field",
                    "label": "Series"
                },
                {
                    "id": "gridSeries",
                    "type": "field",
                    "label": "Grid Series"
                }
            ]
        },
        {
            "name": "GeoMap",
            "controls": [
                {
                    "id": "fitToMarkers",
                    "type": "boolean",
                    "label": "Fit Map To Markers",
                    "defaultValue": "true"
                },
                {
                    "id": "initialLatitude",
                    "type": "text",
                    "label": "Initial Latitude",
                    "defaultValue": "51.0"
                },
                {
                    "id": "initialLongitude",
                    "type": "text",
                    "label": "Initial Longitude",
                    "defaultValue": "0.0"
                },
                {
                    "id": "initialZoomLevel",
                    "type": "number",
                    "label": "Initial Zoom Level",
                    "defaultValue": "13",
                    "max": "25",
                    "min": "1"
                },
                {
                    "id": "tileServerUrl",
                    "type": "text",
                    "label": "Tile Server URL",
                    "defaultValue": "https://{s}.tile.osm.org/{z}/{x}/{y}.png"
                },
                {
                    "id": "tileServerAttribution",
                    "type": "text",
                    "label": "Tile Server Attribution",
                    "defaultValue": "&copy; <a href='http://osm.org/copyright'>OpenStreetMap</a> contributors"
                },
                {
                    "id": "isColourByEventTimeEnabled",
                    "type": "selection",
                    "label": "Colour By Event Time (earliest dark, latest light)",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "10000",
                    "max": "500000",
                    "min": "1"
                },
                {
                    "id": "sortSeries",
                    "type": "selection",
                    "label": "Sort Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "sortGridSeries",
                    "type": "selection",
                    "label": "Sort Grid Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "seriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "gridSeriesDateFormat",
                    "type": "text",
                    "label": "Grid Series Date Format (opt.)",
                    "defaultValue": ""
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${gridSeries}",
                    "sort": {
                        "direction": "${sortGridSeries}",
                        "enabled": "true",
                        "priority": 0
                    }
                },
                "nest": {
                    "key": {
                        "id": "${series}",
                        "sort": {
                            "direction": "${sortSeries}",
                            "enabled": "true",
                            "priority": 1
                        }
                    },
                    "values": {
                        "fields": [
                            {
                                "id": "${name}",
                                "sort": {
                                    "direction": "Ascending",
                                    "enabled": "true",
                                    "priority": 2
                                }
                            },
                            {
                                "id": "${lat}"
                            },
                            {
                                "id": "${lon}"
                            },
                            {
                                "id": "${eventTime}"
                            },
                            {
                                "id": "${iconName}"
                            },
                            {
                                "id": "${series}"
                            },
                            {
                                "id": "${gridSeries}"
                            }
                        ],
                        "limit": {
                            "enabled": "true",
                            "size": "${maxValues}"
                        }
                    },
                    "limit": {
                        "enabled": "true",
                        "size": "100"
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "25"
                }
            }
        }
    }
}
