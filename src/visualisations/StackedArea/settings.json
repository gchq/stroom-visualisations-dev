{
    "inputs": [
        {
            "id": "x",
            "label": "X axis",
            "description": "Where each value is along the bottom: a time, number or category",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "y",
            "label": "Y axis",
            "description": "The value each series adds to the stack",
            "types": [
                "NUMBER"
            ],
            "required": true
        },
        {
            "id": "lineSeries",
            "label": "Series",
            "description": "Splits the values into areas stacked one on another, each in its own colour",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "gridSeries",
            "label": "Grid series",
            "description": "Draws a separate chart for each value",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "x",
                    "type": "field",
                    "label": "X Axis"
                },
                {
                    "id": "y",
                    "type": "field",
                    "label": "Y Axis"
                },
                {
                    "id": "lineSeries",
                    "type": "field",
                    "label": "Series"
                },
                {
                    "id": "gridSeries",
                    "type": "field",
                    "label": "Grid Series"
                }
            ]
        },
        {
            "name": "Area",
            "controls": [
                {
                    "id": "interpolationMode",
                    "type": "selection",
                    "label": "Interpolation Mode",
                    "values": [
                        "",
                        "linear",
                        "linear-closed",
                        "step",
                        "step-before",
                        "step-after",
                        "basis",
                        "basis-open",
                        "basis-closed",
                        "bundle",
                        "cardinal",
                        "cardinal-open",
                        "cardinal-closed",
                        "monotone"
                    ],
                    "defaultValue": "linear"
                },
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "500",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "sortXAxis",
                    "type": "selection",
                    "label": "Sort X Axis",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "sortLineSeries",
                    "type": "selection",
                    "label": "Sort Line Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxLineSeries",
                    "type": "number",
                    "label": "Max Line Series",
                    "defaultValue": "100",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "seriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "sortGridSeries",
                    "type": "selection",
                    "label": "Sort Grid Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxGridSeries",
                    "type": "number",
                    "label": "Max Grid Series",
                    "defaultValue": "36",
                    "max": "144",
                    "min": "1"
                },
                {
                    "id": "gridSeriesDateFormat",
                    "type": "text",
                    "label": "Grid Series Date Format (optional)",
                    "defaultValue": ""
                },
                {
                    "id": "synchXAxis",
                    "type": "selection",
                    "label": "Synch X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayXAxis",
                    "type": "selection",
                    "label": "Display X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "synchYAxis",
                    "type": "selection",
                    "label": "Synch Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayYAxis",
                    "type": "selection",
                    "label": "Display Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${gridSeries}",
                    "sort": {
                        "direction": "${sortGridSeries}",
                        "enabled": "true",
                        "priority": 0
                    }
                },
                "nest": {
                    "key": {
                        "id": "${lineSeries}",
                        "sort": {
                            "direction": "${sortLineSeries}",
                            "enabled": "true",
                            "priority": 1
                        }
                    },
                    "values": {
                        "fields": [
                            {
                                "id": "${x}",
                                "sort": {
                                    "direction": "${sortXAxis}",
                                    "enabled": "true",
                                    "priority": 2
                                }
                            },
                            {
                                "id": "${y}"
                            }
                        ],
                        "limit": {
                            "enabled": "true",
                            "size": "${maxValues}"
                        }
                    },
                    "limit": {
                        "enabled": "true",
                        "size": "${maxLineSeries}"
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "${maxGridSeries}"
                }
            }
        }
    }
}
