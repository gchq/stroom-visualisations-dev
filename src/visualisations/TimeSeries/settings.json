{
    "inputs": [
        {
            "id": "x",
            "label": "X axis",
            "description": "When each value was",
            "types": [
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "y",
            "label": "Y axis",
            "description": "The value the line goes through",
            "types": [
                "NUMBER"
            ],
            "required": true
        },
        {
            "id": "lineSeries",
            "label": "Line series",
            "description": "Draws a separate line for each value, in its colour",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "x",
                    "type": "field",
                    "label": "X Axis"
                },
                {
                    "id": "y",
                    "type": "field",
                    "label": "Y Axis"
                },
                {
                    "id": "lineSeries",
                    "type": "field",
                    "label": "Line Series"
                }
            ]
        },
        {
            "name": "Line",
            "controls": [
                {
                    "id": "interpolationMode",
                    "type": "selection",
                    "label": "Interpolation Mode",
                    "values": [
                        "",
                        "linear",
                        "linear-closed",
                        "step",
                        "step-before",
                        "step-after",
                        "basis",
                        "basis-open",
                        "basis-closed",
                        "bundle",
                        "cardinal",
                        "cardinal-open",
                        "cardinal-closed",
                        "monotone"
                    ],
                    "defaultValue": "monotone"
                },
                {
                    "id": "scaleYAxis",
                    "type": "selection",
                    "label": "Scale Y Axis",
                    "values": [
                        "Linear",
                        "Square",
                        "Cube",
                        "Log"
                    ],
                    "defaultValue": "Linear"
                },
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "1000",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "sortXAxis",
                    "type": "selection",
                    "label": "Sort X Axis",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "sortLineSeries",
                    "type": "selection",
                    "label": "Sort Line Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxLineSeries",
                    "type": "number",
                    "label": "Max Line Series",
                    "defaultValue": "100",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "seriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (opt.)",
                    "defaultValue": ""
                },
                {
                    "id": "displayXAxis",
                    "type": "selection",
                    "label": "Display X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayYAxis",
                    "type": "selection",
                    "label": "Display Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${lineSeries}",
                    "sort": {
                        "direction": "${sortLineSeries}",
                        "enabled": "true",
                        "priority": 0
                    }
                },
                "values": {
                    "fields": [
                        {
                            "id": "${x}",
                            "sort": {
                                "direction": "${sortXAxis}",
                                "enabled": "true",
                                "priority": 1
                            }
                        },
                        {
                            "id": "${y}"
                        }
                    ],
                    "limit": {
                        "enabled": "true",
                        "size": "${maxValues}"
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "${maxLineSeries}"
                }
            }
        }
    }
}
