{
    "inputs": [
        {
            "id": "series",
            "label": "Series",
            "description": "Draws a separate heat map for each value",
            "types": [
                "TEXT",
                "NUMBER",
                "DATE_TIME"
            ],
            "required": false
        },
        {
            "id": "hours",
            "label": "Hours",
            "description": "When each value was, its hour the cell it is in (the values of an hour are added together)",
            "types": [
                "DATE_TIME"
            ],
            "required": true
        },
        {
            "id": "values",
            "label": "Values",
            "description": "The value of each time, which the cell's colour shows",
            "types": [
                "NUMBER"
            ],
            "required": true
        }
    ],
    "tabs": [
        {
            "name": "Data",
            "controls": [
                {
                    "id": "series",
                    "type": "field",
                    "label": "Series"
                },
                {
                    "id": "hours",
                    "type": "field",
                    "label": "Hours"
                },
                {
                    "id": "values",
                    "type": "field",
                    "label": "Values"
                }
            ]
        },
        {
            "name": "Series",
            "controls": [
                {
                    "id": "maxValues",
                    "type": "number",
                    "label": "Max Values",
                    "defaultValue": "940",
                    "max": "10000",
                    "min": "1"
                },
                {
                    "id": "sortSeries",
                    "type": "selection",
                    "label": "Sort Series",
                    "values": [
                        "",
                        "Ascending",
                        "Descending"
                    ],
                    "defaultValue": "Ascending"
                },
                {
                    "id": "maxSeries",
                    "type": "number",
                    "label": "Max Series",
                    "defaultValue": "20",
                    "max": "144",
                    "min": "1"
                },
                {
                    "id": "gridSeriesDateFormat",
                    "type": "text",
                    "label": "Series Date Format (optional)",
                    "defaultValue": ""
                },
                {
                    "id": "displayXAxis",
                    "type": "selection",
                    "label": "Display X Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                },
                {
                    "id": "displayYAxis",
                    "type": "selection",
                    "label": "Display Y Axis",
                    "values": [
                        "True",
                        "False"
                    ],
                    "defaultValue": "True"
                }
            ]
        }
    ],
    "data": {
        "structure": {
            "nest": {
                "key": {
                    "id": "${series}",
                    "sort": {
                        "enabled": "true",
                        "direction": "${sortSeries}"
                    }
                },
                "limit": {
                    "enabled": "true",
                    "size": "${maxSeries}"
                },
                "values": {
                    "fields": [
                        {
                            "id": "${hours}"
                        },
                        {
                            "id": "${values}"
                        }
                    ],
                    "limit": {
                        "enabled": "true",
                        "size": "${maxValues}"
                    }
                }
            }
        }
    }
}
